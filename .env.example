# PostgreSQL (placeholders only — put real values in local .env, never commit them)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional email (Resend SMTP or Gmail). Without these, invites log in development only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tafsula <noreply@yourdomain.com>"

# Optional local seed script passwords (scripts/seed-test-accounts.js)
SEED_ADMIN_PASSWORD=""
SEED_HR_PASSWORD=""
SEED_MEMBER_PASSWORD=""
SEED_ADMIN_EMAIL="admin@tafsula.test"

# Optional AI for Story Studio (bureau presentations). Any one is enough.
